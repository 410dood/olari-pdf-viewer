{
  "name": "olari.PdfViewer",
  "widgetName": "PdfViewer",
  "version": "1.2.0",
  "description": "Olari in-house PDF viewer. Streams a FileDocument by URL (no base64), loads the app's single pinned pdf.js (theme/web/resources/pdfjs/<version>) and never leaves its window.pdfjsLib global behind.",
  "author": "Olari",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "mxpackage": {
    "name": "olari.PdfViewer",
    "type": "widget",
    "mpkName": "olari.PdfViewer.mpk"
  },
  "packagePath": "olari",
  "config": {
    "projectPath": "C:\\Users\\willi\\Mendix\\Olari-main",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3002
  },
  "scripts": {
    "start": "pluggable-widgets-tools start:server",
    "dev": "pluggable-widgets-tools start:web",
    "build": "pluggable-widgets-tools build:web",
    "lint": "pluggable-widgets-tools lint",
    "release": "pluggable-widgets-tools release:web",
    "sync-pdfjs": "node scripts/sync-shared-pdfjs.js"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38",
    "@mendix/pluggable-widgets-tools": "^11.3.1",
    "@rollup/plugin-json": "^6.1.0",
    "rollup": "^3.29.4"
  },
  "overrides": {
    "react": "19.0.0",
    "@types/react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react-dom": "19.0.0"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0"
  }
}
